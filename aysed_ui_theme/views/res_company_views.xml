<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ٢. إخـفاء زر "إنشاء شركة جـديدة" (View Access Control) -->
        <!-- في واجهة المـشترك، يـجب ألا يـظهر زر الـبلاص (+) أو "إنشاء شركة"؛ الكـود التـالي يـخفيه برمجياً -->
        <record id="view_company_tree_inherit_saas" model="ir.ui.view">
            <field name="name">res.company.tree.inherit.saas</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_create_new_company']" position="attributes">
                    <attribute name="groups">base.group_system</attribute>
                    <attribute name="invisible">user_id != 2</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_company_form_inherit_saas" model="ir.ui.view">
            <field name="name">res.company.form.inherit.saas</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_create_new_company']" position="attributes">
                    <attribute name="groups">base.group_system</attribute>
                    <attribute name="invisible">user_id != 2</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
