<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Configure standard Annual Leave Type (is_annual = True) -->
        <record id="hr_holidays.holiday_status_cl" model="hr.leave.type">
            <field name="is_annual">True</field>
            <field name="is_unpaid">False</field>
        </record>

        <!-- Configure standard Unpaid Leave Type (is_unpaid = True) -->
        <record id="hr_holidays.holiday_status_unpaid" model="hr.leave.type">
            <field name="is_annual">False</field>
            <field name="is_unpaid">True</field>
        </record>
    </data>
</odoo>
