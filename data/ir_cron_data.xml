<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Scheduled Action (Cron): Monthly Leave Accrual (2.5 Days/Month according to Kuwait Labor Law) -->
        <record id="ir_cron_monthly_leave_accrual" model="ir.cron">
            <field name="name">Accrual Engine: Monthly Leave Accrual (Kuwait Law 2.5 Days)</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model.cron_monthly_leave_accrual()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="doall" eval="False"/>
        </record>
    </data>
</odoo>
