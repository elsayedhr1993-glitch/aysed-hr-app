# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional. Used for OpenAI Vision OCR if provided in secrets.
OPENAI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
# SMTP Configuration for sending emails
SMTP_USER=
SMTP_PASS=

# Firebase Admin Service Account JSON (Optional, for admin operations)
FIREBASE_SERVICE_ACCOUNT=

# UltraMsg WhatsApp Live API Integration
VITE_ULTRAMSG_INSTANCE_ID=instance188430
VITE_ULTRAMSG_TOKEN=mh21qnlb8vngnkml
VITE_ULTRAMSG_BASE_URL=https://api.ultramsg.com/instance188430/
