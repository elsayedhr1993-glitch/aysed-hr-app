<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. القائمة الجذرية (الأيقونة الرئيسية في واجهة أودو) -->
    <menuitem id="aysed_system_root"
              name="نظام السيد المتكامل 2026"
              web_icon="aysed_hr,static/description/icon.png"
              sequence="1"/>

    <!-- ======================================================== -->
    <!-- 2. التصنيفات الكبيرة في اللوحة الجانبية (Categories) -->
    <!-- ======================================================== -->

    <!-- قسم الموارد البشرية -->
    <menuitem id="menu_hr_main_category"
              name="إدارة الموارد البشرية"
              parent="aysed_system_root"
              sequence="10"/>

    <!-- قسم الخدمات الذكية (OCR والموسيقى والعيادة) -->
    <menuitem id="menu_smart_services_category"
              name="الخدمات والأنظمة الذكية"
              parent="aysed_system_root"
              sequence="20"/>

    <!-- قسم الإعدادات -->
    <menuitem id="menu_configuration_category"
              name="الإعدادات والتهيئة"
              parent="aysed_system_root"
              sequence="100"/>

    <!-- ======================================================== -->
    <!-- 3. الروابط الفعلية (التي تفتح الشاشات) -->
    <!-- ======================================================== -->

    <!-- روابط الموارد البشرية -->
    <menuitem id="menu_hr_contracts" name="عقود العمل" 
              parent="menu_hr_main_category" sequence="1" action="ACTION_ID_CONTRACTS"/>
    <menuitem id="menu_hr_leaves" name="الإجازات" 
              parent="menu_hr_main_category" sequence="2" action="ACTION_ID_LEAVES"/>

    <!-- روابط الخدمات الذكية -->
    <menuitem id="menu_ocr_service" name="نظام OCR للهويات" 
              parent="menu_smart_services_category" sequence="1" action="ACTION_ID_OCR"/>
    <menuitem id="menu_music_service" name="الموسيقى البيئية" 
              parent="menu_smart_services_category" sequence="2" action="ACTION_ID_MUSIC"/>
    <menuitem id="menu_clinic_service" name="إيليت كلينك" 
              parent="menu_smart_services_category" sequence="3" action="ACTION_ID_CLINIC"/>

    <!-- روابط الإعدادات -->
    <menuitem id="menu_system_settings" name="إعدادات النظام" 
              parent="menu_configuration_category" sequence="1" action="ACTION_ID_SETTINGS"/>
</odoo>
